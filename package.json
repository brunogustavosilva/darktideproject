{
  "name": "darktide-login",
  "version": "1.0.0",
  "private": true,
  "description": "Tela de login e boas-vindas com Express e PostgreSQL opcional",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently -k -n api,web \"node --watch server.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "db:seed": "node scripts/seed.js"
  },
  "dependencies": {
    "@neon/config": "^1.8.6",
    "@neon/env": "^1.5.3",
    "bcryptjs": "^3.0.2",
    "dotenv": "^18.0.7",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "node-cron": "^4.6.0",
    "pg": "^8.16.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "vite": "^8.3.4"
  }
}
